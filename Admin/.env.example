# Public URL of the NAR API (no trailing slash). The API and this dashboard must be on the
# same site (e.g. api.example.com and admin.example.com) so the session cookie is sent.
VITE_API_URL=http://localhost:3000

# Vercel only (not read by `npm run dev`): origin of the API that middleware.ts proxies /admin/* to,
# e.g. https://api.example.com. Set it next to ADMIN_PROXY_SECRET.
# BACKEND_URL=
